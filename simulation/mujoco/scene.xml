<!-- Nori scene — floor, light, visuals; includes the robot. Load this file. -->
<mujoco model="nori_scene">
  <include file="nori.xml"/>

  <statistic center="0 0 0.4" extent="1.2"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <rgba haze="0.7 0.8 0.9 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.75 0.95" rgb2="0.85 0.9 0.95"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.75 0.78 0.82" rgb2="0.55 0.6 0.68" markrgb="0.9 0.9 0.9"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="1 1 3" dir="-0.3 -0.3 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Mappable environment: a 6x6 m room + one interior obstacle. Everything the
         lidar should detect lives in geom group 2 (the plugin masks its ray fan to
         group 2, so it sees walls, not the robot's own body). Static world geoms. -->
    <geom name="wall_north" type="box" group="2" pos="0 3 0.25"  size="3.05 0.05 0.25" rgba="0.8 0.8 0.82 1"/>
    <geom name="wall_south" type="box" group="2" pos="0 -3 0.25" size="3.05 0.05 0.25" rgba="0.8 0.8 0.82 1"/>
    <geom name="wall_east"  type="box" group="2" pos="3 0 0.25"  size="0.05 3.05 0.25" rgba="0.8 0.8 0.82 1"/>
    <geom name="wall_west"  type="box" group="2" pos="-3 0 0.25" size="0.05 3.05 0.25" rgba="0.8 0.8 0.82 1"/>
    <geom name="obstacle"   type="box" group="2" pos="1.2 1.0 0.25" size="0.25 0.25 0.25" rgba="0.7 0.55 0.4 1"/>
  </worldbody>
</mujoco>
