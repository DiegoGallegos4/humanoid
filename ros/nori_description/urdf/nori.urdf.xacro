<?xml version="1.0"?>
<!-- Nori URDF (Stage 6) — kinematics/TF for ROS, mirrors simulation/mujoco/nori.xml.
     Joint names are the shared contract (architecture.md §6). MuJoCo (MJCF) is the
     physics plant; this URDF drives robot_state_publisher / RViz / MoveIt. Keep the
     joint set and names in sync with the MJCF and firmware messages.hpp. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nori">

  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="mjcf_path" default=""/>

  <material name="grey"><color rgba="0.4 0.4 0.45 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.18 1"/></material>

  <!-- ============================ links & joints ========================= -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.30 0.30 0.15"/></geometry>
      <material name="grey"/></visual>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.06" length="0.024"/></geometry>
        <material name="dark"/></visual>
    </link>
    <joint name="base_${side}_wheel" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left"  y="0.13"/>
  <xacro:wheel side="right" y="-0.13"/>

  <!-- torso lift (prismatic) -->
  <link name="torso_link">
    <visual><origin xyz="0 0 0.175"/><geometry><box size="0.10 0.12 0.35"/></geometry>
      <material name="grey"/></visual>
  </link>
  <joint name="torso_lift" type="prismatic">
    <parent link="base_link"/><child link="torso_link"/>
    <origin xyz="0 0 0.09"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="0.30" effort="400" velocity="0.2"/>
  </joint>

  <!-- head -->
  <link name="head_pan_link"/>
  <joint name="head_pan" type="revolute">
    <parent link="torso_link"/><child link="head_pan_link"/>
    <origin xyz="0 0 0.50"/><axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="15" velocity="3"/>
  </joint>
  <link name="head_tilt_link">
    <visual><geometry><box size="0.10 0.12 0.10"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link"/><child link="head_tilt_link"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="15" velocity="3"/>
  </joint>

  <!-- SO-101 arm macro (5-DOF + gripper) -->
  <xacro:macro name="arm" params="side y">
    <link name="${side}_shoulder_link"><visual><geometry><sphere radius="0.03"/></geometry>
      <material name="dark"/></visual></link>
    <joint name="${side}_shoulder_pan" type="revolute">
      <parent link="torso_link"/><child link="${side}_shoulder_link"/>
      <origin xyz="0 ${y} 0.35"/><axis xyz="0 0 1"/>
      <limit lower="-1.9" upper="1.9" effort="15" velocity="3"/>
    </joint>
    <link name="${side}_upper_arm_link"><visual><origin xyz="0 0 -0.06"/>
      <geometry><cylinder radius="0.02" length="0.12"/></geometry><material name="grey"/></visual></link>
    <joint name="${side}_shoulder_lift" type="revolute">
      <parent link="${side}_shoulder_link"/><child link="${side}_upper_arm_link"/>
      <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
      <limit lower="-1.9" upper="1.9" effort="15" velocity="3"/>
    </joint>
    <link name="${side}_forearm_link"><visual><origin xyz="0 0 -0.06"/>
      <geometry><cylinder radius="0.018" length="0.12"/></geometry><material name="grey"/></visual></link>
    <joint name="${side}_elbow" type="revolute">
      <parent link="${side}_upper_arm_link"/><child link="${side}_forearm_link"/>
      <origin xyz="0 0 -0.12"/><axis xyz="0 1 0"/>
      <limit lower="0" upper="2.4" effort="15" velocity="3"/>
    </joint>
    <link name="${side}_wrist_link"><visual><origin xyz="0 0 -0.025"/>
      <geometry><cylinder radius="0.015" length="0.05"/></geometry><material name="dark"/></visual></link>
    <joint name="${side}_wrist_flex" type="revolute">
      <parent link="${side}_forearm_link"/><child link="${side}_wrist_link"/>
      <origin xyz="0 0 -0.12"/><axis xyz="0 1 0"/>
      <limit lower="-1.9" upper="1.9" effort="15" velocity="3"/>
    </joint>
    <link name="${side}_gripper_base_link"><visual><geometry><box size="0.04 0.06 0.03"/></geometry>
      <material name="dark"/></visual></link>
    <joint name="${side}_wrist_roll" type="revolute">
      <parent link="${side}_wrist_link"/><child link="${side}_gripper_base_link"/>
      <origin xyz="0 0 -0.05"/><axis xyz="0 0 1"/>
      <limit lower="-3.0" upper="3.0" effort="15" velocity="3"/>
    </joint>
    <link name="${side}_finger_link"><visual><geometry><box size="0.01 0.01 0.05"/></geometry>
      <material name="grey"/></visual></link>
    <joint name="${side}_gripper" type="prismatic">
      <parent link="${side}_gripper_base_link"/><child link="${side}_finger_link"/>
      <origin xyz="0 0.02 -0.03"/><axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.05" effort="15" velocity="1"/>
    </joint>
  </xacro:macro>
  <xacro:arm side="left"  y="0.13"/>
  <xacro:arm side="right" y="-0.13"/>

  <!-- ============================ ros2_control =========================== -->
  <ros2_control name="nori_system" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <plugin>nori_hardware/NoriMujocoSystem</plugin>
        <param name="mjcf_path">$(arg mjcf_path)</param>
      </xacro:unless>
    </hardware>

    <!-- velocity-controlled drive wheels -->
    <xacro:macro name="wheel_iface" params="name">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:wheel_iface name="base_left_wheel"/>
    <xacro:wheel_iface name="base_right_wheel"/>

    <!-- position-controlled joints (smart servos + lift) -->
    <xacro:macro name="pos_iface" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:pos_iface name="torso_lift"/>
    <xacro:pos_iface name="head_pan"/>
    <xacro:pos_iface name="head_tilt"/>
    <xacro:pos_iface name="left_shoulder_pan"/>
    <xacro:pos_iface name="left_shoulder_lift"/>
    <xacro:pos_iface name="left_elbow"/>
    <xacro:pos_iface name="left_wrist_flex"/>
    <xacro:pos_iface name="left_wrist_roll"/>
    <xacro:pos_iface name="left_gripper"/>
    <xacro:pos_iface name="right_shoulder_pan"/>
    <xacro:pos_iface name="right_shoulder_lift"/>
    <xacro:pos_iface name="right_elbow"/>
    <xacro:pos_iface name="right_wrist_flex"/>
    <xacro:pos_iface name="right_wrist_roll"/>
    <xacro:pos_iface name="right_gripper"/>
  </ros2_control>
</robot>
